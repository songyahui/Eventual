cabal-version: 3.0
name:          pledge
version:       0.1.0.0
synopsis:      Enforce and check temporal properties of monadic programs
description:
    Pledge is a Haskell library that lets programmers attach temporal
    specifications (preconditions, postconditions, future obligations) to
    monadic actions using a composable algebra of regular expressions,
    separation logic, and weighted automata.
license:       MIT
author:        Yahui Song
maintainer:    Yahui Song
category:      Verification, Control, Concurrency
extra-doc-files: README.md

-- ── Library ───────────────────────────────────────────────────────────────────

library
  hs-source-dirs:   .
  default-language: GHC2021
  exposed-modules:
      Pledge
      Pledge.Core
      Pledge.Event
      Pledge.Presburger
      Pledge.Presburger.Solver
      Pledge.RE
      Pledge.GuardedRE
      Pledge.Semiring
      Pledge.WeightedRE
      Pledge.SL
      Pledge.Tracked
  build-depends:
      base
    , containers
    , sbv
    , transformers

-- ── Executables ───────────────────────────────────────────────────────────────

executable pledge-main
  hs-source-dirs:   .
  main-is:          Examples/Main.hs
  default-language: GHC2021
  build-depends:
      base
    , containers
    , pledge
    , effectful
    , effectful-core
    , QuickCheck
    , sbv
    , random
    , transformers
  other-modules:
      Examples.UnitTest.PledgeTest
      Examples.UnitTest.PresburgerTest
      Examples.RE.Memory
      Examples.RE.MemorySpec
      Examples.RE.FileHandle
      Examples.RE.Mutex
      Examples.RE.Transaction
      Examples.RE.CryptoSession
      Examples.RE.NetworkProtocol
      Examples.RE.Capability
      Examples.RE.Sensor
      Examples.RE.Shadow
      Examples.SL.HeapMemory
      Examples.SL.BankAccount
      Examples.SL.LinkedList
      Examples.GuardedRE.Memory
      Examples.GuardedRE.BoundedCounter
      Examples.WeightedRE.Memory
      Examples.WeightedRE.TaskScheduler

-- ── Test suite ────────────────────────────────────────────────────────────────

test-suite pledge-laws
  type:             exitcode-stdio-1.0
  hs-source-dirs:   .
  main-is:          Tests/RELaws.hs
  default-language: GHC2021
  build-depends:
      base
    , pledge
    , QuickCheck

executable pledge-solver-test
  hs-source-dirs:   .
  main-is:          Examples/SL/SolverTest.hs
  default-language: GHC2021
  build-depends:
      base
    , containers
    , pledge
    , sbv
  other-modules:
      Solver
